# ---- Free setup (enough on its own) ----

# Gemini free tier - key from https://aistudio.google.com/
# Primary models for text, image, docs and video.
GEMINI_API_KEY=

# OpenRouter free models - key from https://openrouter.ai/keys
# Tried first for text and image; falls back to Gemini automatically.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openrouter/free

# ---- Optional extra providers (skipped when blank) ----
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Image Identification (person identify panel) ----
# Optional. Used for reverse-image / person identification features.
# Get a free key at https://serpapi.com (100 free searches/month)
SERPAPI_KEY=
# Get a free key at https://api.imgbb.com (hosts uploaded images so Google Lens can see them)
IMGBB_API_KEY=
